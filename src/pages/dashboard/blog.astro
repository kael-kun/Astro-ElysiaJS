---
import { DashboardLayout } from "src/components/layout/DashboardLayout"
import { BlogContent } from "src/components/blog/BlogContent"
import Layout from '../../layouts/Layout.astro';
---

<Layout>
	<DashboardLayout client:load title="Blog Generator">
		<BlogContent client:only="react" server:defer>
		<div slot="fallback" class="h-[100vh] w-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center p-4">
		<div class="w-full max-w-3xl space-y-6">
			<div class="flex flex-col items-center space-y-3">
				<div class="animate-pulse w-full h-64 rounded-lg bg-gray-300 dark:bg-gray-600"></div>
					</div>
					<div class="pt-4">
					<div class="animate-pulse h-12 rounded-lg bg-gray-300 dark:bg-gray-600 w-full"></div>
				</div>
			</div>
		</div>
	</BlogContent >
	</DashboardLayout>
</Layout>
